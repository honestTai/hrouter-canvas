{
  "name": "hrouter-canvas-mcp",
  "version": "0.1.0",
  "description": "Infinite-canvas image generation for coding agents: an MCP server plus a local canvas, for any OpenAI-Images or Gemini compatible site.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hrouter-canvas": "dist/cli.mjs",
    "hrouter-canvas-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "mcp",
    "image-generation",
    "infinite-canvas",
    "claude-code",
    "codex",
    "opencode",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honestTai/hrouter-canvas.git"
  },
  "homepage": "https://github.com/honestTai/hrouter-canvas#readme",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test --test-force-exit --test-timeout=60000 test/*.test.ts",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.12.0",
    "esbuild": "0.28.1",
    "jsdom": "30.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "zod": "^4.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
